<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="panic"
        android:enabled="true"
        android:icon="@drawable/ic_panic"
        android:shortcutShortLabel="@string/shortcut_panic">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.focusguard.MainActivity"
            android:targetPackage="com.focusguard">
            <extra android:name="route" android:value="panic" />
