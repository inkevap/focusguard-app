# Copia este archivo a `.env` en la raíz del repositorio y rellénalo. `.env` no se sube.
# Dominio público (Caddy pide el certificado solo). Sin esquema.
DOMAIN=focusguard.example.com
# Nombre público del resolvedor DNS (con su registro DNS apuntando al VPS). Ver dns/README.md.
DNS_DOMAIN=dns.focusguard.example.com
# IP del VPS (separadas por comas): la app las usa para llegar al resolvedor sin depender del DNS del sistema.
DNS_DOH_BOOTSTRAP=
# Dirección pública del servidor, sin barra final (se usa en los enlaces de los correos).
PUBLIC_URL=https://focusguard.example.com
PORT=3000
# Contraseña de PostgreSQL (la usan la base y el servidor). Mejor sin símbolos raros: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Mínimo 32 caracteres aleatorios: `openssl rand -base64 48`.
JWT_SECRET=
# Obligatorio en producción: sin SMTP el servidor no arranca.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FocusGuard <avisos@focusguard.example.com>"
# Clave JSON de la cuenta de servicio de Firebase (push). Se monta como fichero fuera del repositorio; sin ella no hay push.
FCM_SERVICE_ACCOUNT_FILE=
